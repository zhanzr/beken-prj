#@ Enable Override Flash Partition
CONFIG_OVERRIDE_FLASH_PARTITION=y
#@ Cpu1 core offset address default 0x2e0000
CONFIG_SYS_CPU1_OFFSET=0x21b0000
#@ internal sensors: die temperature (dts) + battery voltage (vbat)
CONFIG_TEMP_DETECT=y
CONFIG_VOLT_DETECT=y
#@ GC2145 DVP camera (vendor dvp_camera framework)
CONFIG_JPEGENC_HW=y
CONFIG_DVP_CAMERA=y
CONFIG_YUV_BUF=y
CONFIG_H264=y
CONFIG_CAMERA_CTRL_POWER_GPIO_ID=49
CONFIG_CAMERA_CTRL_RESET_GPIO_CTRL=28
#@ the camera SCCB runs on P42/P43 via the sim (bit-bang) I2C driver,
#@ exactly as the vendor beken_genie cp1 config does
CONFIG_SIM_I2C=y
CONFIG_SIM_I2C_SDA_GPIO=43
CONFIG_SIM_I2C_SCL_GPIO=42
CONFIG_SIM_I2C_HW_BOARD_V3=y
