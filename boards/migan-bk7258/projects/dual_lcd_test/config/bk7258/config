#@ cp0: minimal (LDO33/backlight on cp0; the LCD stack runs on cp1)
#@ Enable Override Flash Partition
CONFIG_OVERRIDE_FLASH_PARTITION=y
#@ Cpu1 core offset address default 0x2e0000
CONFIG_SYS_CPU1_OFFSET=0x21b0000
#@ run CPU0 at its max frequency
CONFIG_CPU_FREQ_HZ=240000000
#@ PWM for the backlight
CONFIG_PWM=y
