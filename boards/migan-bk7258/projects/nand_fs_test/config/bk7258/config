#@ Enable Override Flash Partition
CONFIG_OVERRIDE_FLASH_PARTITION=y
#@ Cpu1 core offset address default 0x2e0000
CONFIG_SYS_CPU1_OFFSET=0x21b0000
#@ SD-NAND on the SDIO host (P14-P19, 4-line)
CONFIG_SDIO_HOST=y
#@ SD card block driver
CONFIG_SDCARD=y
CONFIG_SDCARD_DEBUG_SUPPORT=y
#@ FATFS over the SD-NAND
CONFIG_FATFS=y
CONFIG_FATFS_SDCARD=y
