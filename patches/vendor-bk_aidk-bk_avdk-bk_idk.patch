+def _wsl_path(p):
+	p = p.replace('\\', '/')
+	if re.match('^[A-Za-z]:/', p):
+		return '/mnt/%s%s'%(p[0].lower(), p[2:])
+	m = re.match('^/([A-Za-z])/(.*)', p)   # MSYS style: /d/...
+	if m:
+		return '/mnt/%s/%s'%(m.group(1).lower(), m.group(2))
+	return p
+
+def _win_path(p):
+	"""Normalize an MSYS-style /d/... path to a Windows D:/... path."""
+	p = p.replace('\\', '/')
+	m = re.match('^/([A-Za-z])/(.*)', p)
+	if m:
+		return '%s:/%s'%(m.group(1).upper(), m.group(2))
+	return p
+
+_GEN_VIA_WSL = True
+
+def _tool_path(p):
+	"""Convert a path to the style the selected Gen_image tool understands."""
+	return _wsl_path(p) if _GEN_VIA_WSL else _win_path(p)
+
+def _gen_image_cmd():
+	"""Return a shell command prefix that runs the Gen_image pack tool.
+
+	On Windows the SDK's own cmake_Gen_image.exe crashes; prefer a native
+	Windows build pointed to by GEN_IMAGE_WIN_EXE, otherwise fall back to
+	the Linux binary via WSL. On Linux use the tool in place."""
+	global _GEN_VIA_WSL
+	tool = '%s/tools/env_tools/beken_packager/cmake_Gen_image'%(armino_path)
+	if sys.platform != 'win32':
+		_GEN_VIA_WSL = False
+		return tool
+	gen_win = os.environ.get('GEN_IMAGE_WIN_EXE')
+	if gen_win and os.path.isfile(gen_win):
+		_GEN_VIA_WSL = False
+		return gen_win
+	_GEN_VIA_WSL = True
+	return 'wsl.exe --cd "%s" %s'%(build_path, _wsl_path(tool))
+
+if sys.platform == 'win32':
+	GEN_IMAGE_TOOL = 'cmake_Gen_image.exe'
+else:
+	GEN_IMAGE_TOOL = 'cmake_Gen_image'
+
 def parse_args():
     description = '''Beken HID Downloader.'''
     parser = argparse.ArgumentParser(description=description)
